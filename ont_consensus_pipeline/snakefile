# Snakefile
import os
import glob

configfile: "config.yaml"

##chikungunya ref mapping
# Define samples from raw-data
#SAMPLES = [os.path.basename(f).split('.')[0] for f in glob.glob("data/raw-data/*.fastq*")]
#SAMPLES = [os.path.splitext(os.path.basename(f))[0].replace('.fastq', '') 
#          for f in glob.glob("data/raw-data/*.fastq.gz")]  # Only .fastq.gz files
SAMPLES = config["samples"]

rule all:
    input:
        expand("results/consensus/{sample}.consensus.fa", sample=SAMPLES)

rule seqkit_stats:
    input:
        "data/raw-data/{sample}.fastq.gz"
    output:
        "results/{sample}_stats.txt"
    threads: 12
    log:
        "logs/{sample}_seqkit_stats.log"
    shell:
        """
        mkdir -p {results,logs}/ && \
        module purge && module load seqkit/2.10.0 && \
        seqkit stats -j {threads} -Ta {input} > {output} 2> {log}"
        """
rule length_filter:
    input:
        "data/raw-data/{sample}.fastq.gz"
    output:
        "processed-data/{sample}.len.fastq"
    threads: 12
    shell:
        """
	module purge && module load seqkit/2.10.0 && \
        seqkit seq -m 100 -M 12500 -j {threads} {input} > {output}
        """
