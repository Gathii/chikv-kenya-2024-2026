rule porechop_trim:
     input:
         "processed-data/{sample}.len.fastq"
     output:
         "processed-data/{sample}.len.trim.fastq"
     threads: 12
     shell:
         """
         module purge && module load porechop/0.2.4 && \
         porechop -i {input} -o {output} -t {threads} --discard_middle -v=0
	 """
rule minimap2_align_and_sort:
    input:
        ref = config["reference"],
        fq = "processed-data/{sample}.len.trim.fastq"
    output:
        bam = "results/mapping/{sample}.sorted.bam",
        bai = "results/mapping/{sample}.sorted.bam.bai"
    threads: 18
    shell:
        """
        module purge && module load minimap2/2.29 samtools/1.21 && \
        minimap2 -ax asm20 -t {threads} {input.ref} {input.fq} | \
        samtools view -Sb - --threads {threads} | \
        samtools sort -o {output.bam} --threads {threads} && \
        samtools index {output.bam} --threads {threads}
        """
rule generate_consensus:
    input:
        ref = config["reference"],
        bam = "results/mapping/{sample}.sorted.bam"
    output:
        cons = "results/consensus/{sample}.consensus.fa"
    shell:
        """
        module purge && module load samtools/1.21 ivar/1.4.4 && \
        samtools mpileup -aa -A -d 1000000 -B -f {input.ref} {input.bam} | \
        ivar consensus -m 20 -q 10 -t 0 -p results/consensus/{wildcards.sample}.consensus
        """
